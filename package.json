{
  "homepage": "https://local-tool/internal",
  "name": "sjexcel-tool",
  "version": "1.0.0",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder"
  },
  "extraResources": [],
  "devDependencies": {
    "electron": "22.3.27",
    "electron-builder": "^24.13.3"
  },
  "dependencies": {
    "xlsx": "^0.18.5"
  },
  "build": {
    "win": {
      "icon": "icons/icon.ico",
      "target": [
        {"target":"portable","arch":["x64"],"artifactName": "Excel工具.exe"},
        {"target":"nsis","arch":["x64"],"artifactName": "Excel工具-setup.exe"}
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "files": [
      "main.js",
      "index.html",
      "icons/",
      "!node_modules/electron/**",
      "!node_modules/electron-builder/**"
    ]
  }
}
