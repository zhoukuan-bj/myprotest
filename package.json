{
  "homepage": "https://local-tool/internal",
  "name": "sjexcel-tool",
  "author": "szzk001",
  "version": "1.0.0",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder",
    "postbuild": "cd dist && mv sjexcel-tool-portable.exe \"Excel工具.exe\" && mv sjexcel-tool-nsis.exe \"Excel工具-setup.exe\""
  },
  "devDependencies": {
    "electron": "22.3.27",
    "electron-builder": "^24.13.3"
  },
  "dependencies": {
    "xlsx": "^0.18.5"
  },
  "build": {
    "publish": null,
    "extraResources": [],
    "win": {
      "icon": "icons/icon.ico",
      "target": [
        {"target":"portable","arch":["x64"]},
        {"target":"nsis","arch":["x64"]}
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "files": [
      "main.js",
      "index.html",
      "icons/",
      "!node_modules/electron/**",
      "!node_modules/electron-builder/**"
    ]
  }
}
